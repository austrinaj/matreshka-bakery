# Скопируй этот файл в .env и заполни своими значениями

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID сотрудников через запятую (бот покажет твой ID по команде /start)
ADMIN_IDS=

# Пароль для входа в CRM на сайте (/admin)
ADMIN_PASSWORD=admin

# Любая длинная случайная строка
SECRET_KEY=change-me
